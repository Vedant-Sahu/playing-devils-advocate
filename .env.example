# OpenAI API Configuration
OPENAI_API_KEY=your_api_key_here

# Default model for agents
MODEL_NAME=gpt-4o-mini

# Optional: Use different models for different agents to optimize costs
# Teacher and Grading agents benefit from stronger reasoning (gpt-4o)
TEACHER_MODEL=gpt-4o-mini
COORDINATOR_MODEL=gpt-4o-mini

# Student and Critique agents can use lighter models (gpt-4o-mini) to save costs
STUDENT_MODEL=gpt-4o-mini
CRITIQUE_EVAL_MODEL=gpt-4o-mini

# DSPy prompt optimization (optional)
TEACHER_PROMPT_BACKEND=llm  # options: llm, dspy
DSPY_COMPILED_PATH=results/dspy_compiled.pkl
DSPY_MODEL_NAME=gpt-4o-mini
DSPY_TEMPERATURE=0.0
DSPY_INFER_TEMPERATURE=0.0
DSPY_TEACHER_PERSONA=general

# Temperature controls randomness (0.0 = deterministic, 1.0 = creative)
# Lower values (0.3-0.5) recommended for grading consistency
TEMPERATURE=0.7

# Hugging Face Access Token
HF_TOKEN=your_token_here

# ==============================================================================
# PROMPT MODE: Switch between explanation styles
# ==============================================================================
# Options:
#   "concept"   - (default) Focus on key concepts, mechanisms, and intuition
#   "reasoning" - Focus on step-by-step logical reasoning to solve problems
#
# The "reasoning" mode teaches HOW TO SOLVE rather than WHAT TO KNOW:
# - Teacher produces reasoning walkthroughs with explicit logical steps
# - Students critique gaps in the reasoning chain (not missing concepts)
# - Severity judge evaluates broken logical links
#
PROMPT_MODE=concept

# RAG (Retrieval Augmented Generation) - optional
# USE_RAG=1

# Web Search for factual context (requires Tavily API key)
# Get free API key at: https://tavily.com (1000 searches/month free)
USE_WEB_SEARCH=0
TAVILY_API_KEY=your_tavily_api_key_here